---
import Explorer from '../components/Explorer.svelte';
import LangSwitcher from '../components/LangSwitcher.svelte';
import ThemeToggle from '../components/ThemeToggle.svelte';
import script from '../demo/scripts/smoke-test.json';
import landing from '../generated/landing.json';
// Ordem importa: app.css define body{margin:0;padding:0} e theme.css define
// body{...padding:24px}; mesma especificidade, vence quem carrega por ultimo.
// app.css precisa vir primeiro para o padding do site nao ser zerado. E a
// unica fonte dos 9 tokens de design (--sp-*, --radius, --accent, --ok,
// --run, --muted, --card-accent) que o painel usa e que theme.css nao
// define — sem ele o painel publicado perde espacamento, raio de borda,
// destaques "ao vivo" e o respeito a prefers-reduced-motion.
import '../../../src/webview/app.css';
import '../demo/theme.css';
// landing.css carrega por ultimo e usa o seletor de classe `.landing`
// (aplicado abaixo em <body>), que tem mais especificidade que os
// `body { ... }` de app.css/theme.css acima — o fundo/cor/tipografia da
// pagina vencem sem depender de ordem, entao isto nao interfere na regra
// "app.css antes de theme.css" (ver comentario acima e
// tests/site/cssTokens.test.ts). Os tokens --brand-* que ele define ficam
// presos a essa classe, nunca em :root — no espaco de nomes que os
// --vscode-* do painel embutido usam.
import '../styles/landing.css';
import type { Locale } from '../../../src/i18n/locale';

// media/icon.svg usa stroke="currentColor": precisa ser inlinado no HTML (e
// nao referenciado via <img src>) para herdar a cor coral por CSS — um
// <img> nao da acesso ao `color` da pagina para dentro do SVG.
import brandIcon from '../../../media/icon.svg?raw';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = landing[locale];

// Rotulos curtos exclusivos da pagina publica (topbar, CTA, swimlanes,
// privacidade, rodape) — nao existem em site/src/i18n/site.ts porque aquele
// arquivo e o vocabulario do painel embutido (Explorer/FeatureList/Demo/
// ThemeToggle), fora do escopo desta task. Mantidos aqui, junto do layout
// que os usa, em vez de criar um arquivo novo para meia duzia de strings.
const LANDING_STRINGS: Record<
  Locale,
  {
    eyebrow: string;
    cta: string;
    ctaSecondary: string;
    statesLabel: string;
    privacyTitle: string;
    readMore: string;
    footer: string;
  }
> = {
  en: {
    eyebrow: 'VS Code · JetBrains',
    cta: 'Install',
    ctaSecondary: 'View on GitHub',
    statesLabel: 'Live task states',
    privacyTitle: 'Privacy',
    readMore: 'Read the full policy',
    footer: 'MIT licensed, fully local. Built for Claude Code.',
  },
  'pt-br': {
    eyebrow: 'VS Code · JetBrains',
    cta: 'Instalar',
    ctaSecondary: 'Ver no GitHub',
    statesLabel: 'Estados da task ao vivo',
    privacyTitle: 'Privacidade',
    readMore: 'Leia a política completa',
    footer: 'Licença MIT, totalmente local. Feito para o Claude Code.',
  },
  es: {
    eyebrow: 'VS Code · JetBrains',
    cta: 'Instalar',
    ctaSecondary: 'Ver en GitHub',
    statesLabel: 'Estados de la tarea en vivo',
    privacyTitle: 'Privacidad',
    readMore: 'Lee la política completa',
    footer: 'Licencia MIT, totalmente local. Hecho para Claude Code.',
  },
  'zh-cn': {
    eyebrow: 'VS Code · JetBrains',
    cta: '安装',
    ctaSecondary: '查看 GitHub',
    statesLabel: '实时任务状态',
    privacyTitle: '隐私',
    readMore: '阅读完整政策',
    footer: 'MIT 许可，完全本地运行。为 Claude Code 打造。',
  },
  'zh-tw': {
    eyebrow: 'VS Code · JetBrains',
    cta: '安裝',
    ctaSecondary: '查看 GitHub',
    statesLabel: '即時任務狀態',
    privacyTitle: '隱私',
    readMore: '閱讀完整政策',
    footer: 'MIT 授權，完全在本機執行。為 Claude Code 打造。',
  },
};
const strings = LANDING_STRINGS[locale];

// Mesmo README por locale que site/scripts/extractLanding.mjs le (LOCALE_FILES
// la dentro nao e exportado) — usado aqui so para montar o link "leia a
// politica completa", que aponta pro README real no GitHub em vez de tentar
// re-renderizar a tabela de privacy (extractLanding converte so inline
// bold/code/link; a tabela markdown fica como texto cru, ver comentario em
// extractLanding.mjs — fora do escopo desta task).
const README_FILES: Record<Locale, string> = {
  en: 'README.en.md',
  'pt-br': 'README.md',
  es: 'README.es.md',
  'zh-cn': 'README.zh-cn.md',
  'zh-tw': 'README.zh-tw.md',
};
const REPO = 'https://github.com/carlosdealmeida/claude-todos-vscode';
const MARKETPLACE_URL =
  'https://marketplace.visualstudio.com/items?itemName=CarlosJunior1992.claude-todos';
const readMoreHref = `${REPO}/blob/master/${README_FILES[locale]}`;

// content.privacy comeca com um paragrafo intro limpo (ja convertido para
// HTML por toHtml) antes da tabela markdown crua — so o paragrafo entra na
// pagina; a tabela fica para uma iteracao futura que a converta de verdade.
const privacyIntro = content.privacy.split('\n\n')[0];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Claude Todos</title>
    <meta name="description" content={content.tagline} />
    <script is:inline>
      // Unica fonte da precedencia de tema (localStorage > matchMedia >
      // 'dark'); ThemeToggle.svelte so le o data-theme que este script ja
      // aplicou, nunca recalcula. Precisa rodar inline e sincrono aqui no
      // <head>, antes do <body>, porque a island Svelte so hidrata depois
      // da primeira pintura — sem isso, quem escolheu claro veria um
      // lampejo escuro a cada carregamento.
      (function () {
        var KEY = 'claude-todos-theme';
        var saved = null;
        try {
          saved = localStorage.getItem(KEY);
        } catch (e) {
          // Storage bloqueado (modo privado/politica): cai no fallback de
          // matchMedia abaixo em vez de interromper o script.
        }
        // So 'dark'/'light' viram data-theme; qualquer outro valor (de
        // outra origem, ou corrompido) e tratado como "nao salvo".
        var theme =
          saved === 'light' || saved === 'dark'
            ? saved
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="landing">
    <div class="topbar">
      <a class="brand" href={import.meta.env.BASE_URL}>
        <Fragment set:html={brandIcon} />
        <span class="wordmark">Claude Todos</span>
      </a>
      <div class="topbar-actions">
        <LangSwitcher client:load current={locale} />
        <ThemeToggle client:load {locale} />
        <a class="cta" href={MARKETPLACE_URL}>{strings.cta}</a>
      </div>
    </div>
    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">{strings.eyebrow}</p>
          <h1>{content.title}</h1>
          <p class="lede">{content.lede}</p>
          <div class="hero-cta-row">
            <a class="cta" href={MARKETPLACE_URL}>{strings.cta}</a>
            <a class="cta-secondary" href={REPO}>{strings.ctaSecondary}</a>
          </div>
        </div>
        <div class="hero-panel">
          <Explorer client:only="svelte" script={script} locale={locale} />
        </div>
      </section>

      <section class="swimlanes" aria-label={strings.statesLabel}>
        <span class="lane lane-pending"><span class="dot" aria-hidden="true"></span>pending</span>
        <span class="lane lane-in_progress"><span class="dot" aria-hidden="true"></span>in_progress</span>
        <span class="lane lane-completed"><span class="dot" aria-hidden="true"></span>completed</span>
      </section>

      <section class="features">
        <ul>
          {content.features.map((f: string) => <li set:html={f} />)}
        </ul>
      </section>

      <section class="privacy">
        <h2 class="section-title">{strings.privacyTitle}</h2>
        <p set:html={privacyIntro} />
        <p><a href={readMoreHref}>{strings.readMore}</a></p>
      </section>
    </main>
    <footer>
      <p>{strings.footer}</p>
    </footer>
  </body>
</html>
